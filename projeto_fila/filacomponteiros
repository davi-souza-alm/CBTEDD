#include <iostream>

using namespace std;

struct No {
    int senha;
    No *prox;
};

struct Fila {
    No *inicio;
    No *fim;
    int quantidade;
};

struct Guiche {
    int id;
    Fila senhasAtendidas;
    Guiche *prox;
};

//====================== FILA ======================

void inicializar(Fila &f) {
    f.inicio = NULL;
    f.fim = NULL;
    f.quantidade = 0;
}

bool vazia(Fila f) {
    return f.inicio == NULL;
}

void enfileirar(Fila &f, int valor) {

    No *novo = new No;
    novo->senha = valor;
    novo->prox = NULL;

    if(vazia(f)){
        f.inicio = novo;
        f.fim = novo;
    }else{
        f.fim->prox = novo;
        f.fim = novo;
    }

    f.quantidade++;
}

int desenfileirar(Fila &f){

    if(vazia(f))
        return -1;

    No *aux = f.inicio;
    int valor = aux->senha;

    f.inicio = aux->prox;

    if(f.inicio == NULL)
        f.fim = NULL;

    delete aux;

    f.quantidade--;

    return valor;
}

int tamanho(Fila f){
    return f.quantidade;
}

//====================== GUICHÊ ======================

void adicionarGuiche(Guiche *&lista, int id){

    Guiche *novo = new Guiche;

    novo->id = id;
    inicializar(novo->senhasAtendidas);
    novo->prox = NULL;

    if(lista == NULL){
        lista = novo;
    }else{
        Guiche *aux = lista;

        while(aux->prox != NULL)
            aux = aux->prox;

        aux->prox = novo;
    }

    cout << "Guiche " << id << " aberto com sucesso.\n";
}

Guiche* localizarGuiche(Guiche *lista, int id){

    while(lista != NULL){

        if(lista->id == id)
            return lista;

        lista = lista->prox;
    }

    return NULL;
}

int quantidadeGuiches(Guiche *lista){

    int cont = 0;

    while(lista != NULL){
        cont++;
        lista = lista->prox;
    }

    return cont;
}

void listarSenhas(Fila fila){

    if(vazia(fila)){
        cout << "Nenhuma senha atendida.\n";
        return;
    }

    No *aux = fila.inicio;

    while(aux != NULL){
        cout << aux->senha << " ";
        aux = aux->prox;
    }

    cout << endl;
}

//====================== MAIN ======================

int main(){

    Fila senhasGeradas;
    inicializar(senhasGeradas);

    Guiche *listaGuiches = NULL;

    int contadorSenha = 0;
    int opcao;

    do{

        cout << "\n========== SISTEMA ==========\n";
        cout << "Senhas aguardando: " << tamanho(senhasGeradas) << endl;
        cout << "Guiches abertos: " << quantidadeGuiches(listaGuiches) << endl;

        cout << "\n0 - Sair";
        cout << "\n1 - Gerar senha";
        cout << "\n2 - Abrir guiche";
        cout << "\n3 - Realizar atendimento";
        cout << "\n4 - Listar senhas atendidas";
        cout << "\nOpcao: ";
        cin >> opcao;

        switch(opcao){

            case 1:

                contadorSenha++;

                enfileirar(senhasGeradas, contadorSenha);

                cout << "Senha " << contadorSenha << " gerada.\n";

                break;

            case 2:{

                int id;

                cout << "ID do guiche: ";
                cin >> id;

                if(localizarGuiche(listaGuiches,id)!=NULL){

                    cout << "Guiche ja existe.\n";

                }else{

                    adicionarGuiche(listaGuiches,id);

                }

                break;
            }

            case 3:{

                if(vazia(senhasGeradas)){

                    cout << "Nao existem senhas aguardando atendimento.\n";
                    break;
                }

                int id;

                cout << "Guiche: ";
                cin >> id;

                Guiche *g = localizarGuiche(listaGuiches,id);

                if(g==NULL){

                    cout << "Guiche inexistente.\n";

                }else{

                    int senha = desenfileirar(senhasGeradas);

                    cout << "Guiche " << id
                         << " atendendo senha "
                         << senha << endl;

                    enfileirar(g->senhasAtendidas,senha);
                }

                break;
            }

            case 4:{

                int id;

                cout << "ID do guiche: ";
                cin >> id;

                Guiche *g = localizarGuiche(listaGuiches,id);

                if(g==NULL){

                    cout << "Guiche nao encontrado.\n";

                }else{

                    cout << "Senhas atendidas pelo guiche "
                         << id << ": ";

                    listarSenhas(g->senhasAtendidas);
                }

                break;
            }

            case 0:

                if(!vazia(senhasGeradas)){

                    cout << "Nao e possivel encerrar.\n";
                    cout << "Ainda existem "
                         << tamanho(senhasGeradas)
                         << " senhas aguardando.\n";

                    opcao = -1;
                }

                break;

            default:
                cout << "Opcao invalida.\n";
        }

    }while(opcao!=0);

    int totalAtendidas = 0;

    Guiche *aux = listaGuiches;

    while(aux!=NULL){

        totalAtendidas += tamanho(aux->senhasAtendidas);

        aux = aux->prox;
    }

    cout << "\nSistema encerrado.\n";
    cout << "Quantidade de senhas atendidas: "
         << totalAtendidas
         << endl;

    return 0;
}
